# Application surface configuration (all installation roles use the same client).
MN_ENV=dev
# Binary roles bind this automatically: full ~/.mn; client ~/.mn-client.
MN_HOME=~/.mn

# API bearer credential is independent of runtime/federation credentials.
# Empty/unset reads MN_HOME/api.token. Required in production and client mode.
MN_API_HOST=127.0.0.1
MN_API_PORT=54001
MN_API_TOKEN=
MN_API_BASE_URL=
MN_API_REQUEST_SIZE_LIMIT_BYTES=5242880
MN_API_BLUEPRINT_UPLOAD_LIMIT_BYTES=34359738368
MN_API_CORS_ALLOW_ORIGINS=

# Runtime connection: configure with mn node add HOST --token RUNTIME_NODE_TOKEN.
# CLI/API read the private, atomic MN_HOME/client.json on each new request.
# MN_GRPC_TARGET, internal gRPC credentials, catalogs and hooks belong to the
# runtime node and are not used to configure this application surface.

MN_LOG_LEVEL=info
MN_LOGS_ROOT=~/.mn/logs
MN_API_LOG_PATH=
MN_LOG_MAX_BYTES=1048576
MN_LOG_BACKUP_COUNT=5

# Optional application Web UI, only installed in full mode.
MN_WEB_UI_HOST=localhost
MN_WEB_UI_PORT=55173
MN_WEB_UI_API_BASE_URL=
MN_WEB_UI_DIST_DIR=
MN_WEB_UI_PROXY_TIMEOUT_SECONDS=30
