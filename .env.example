# Runtime environment: dev, test, production
MN_ENV=dev

# Base application directory
MN_HOME=~/.mn

# Logging
MN_LOG_LEVEL=info
MN_LOGS_ROOT=~/.mn/logs
MN_API_LOG_PATH=
MN_LOG_MAX_BYTES=1048576
MN_LOG_BACKUP_COUNT=5

# API
MN_API_HOST=127.0.0.1
MN_API_PORT=8000
MN_API_BASE_URL=
MN_API_REQUEST_SIZE_LIMIT_BYTES=5242880
MN_API_CORS_ALLOW_ORIGINS=

# API auth. Required when MN_ENV=production.
MN_API_TOKEN=

# Runtime gRPC
MN_GRPC_TARGET=localhost:55051
MN_GRPC_TIMEOUT_SECONDS=10
MN_GRPC_AUTH_TOKEN=
MN_GRPC_ADMIN_TOKEN=

# Blueprint catalog
MN_BLUEPRINT_SOURCE=github
MN_BLUEPRINT_REPO=https://github.com/example/mn-blueprints.git
MN_BLUEPRINT_LOCAL=
MN_BLUEPRINT_REPO_CACHE=~/.cache/mirror-neuron/blueprint-repos

# Web UI
MN_WEB_UI_HOST=localhost
MN_WEB_UI_PORT=55173
MN_WEB_UI_API_BASE_URL=
MN_WEB_UI_DIST_DIR=
MN_WEB_UI_PROXY_TIMEOUT_SECONDS=30

# Optional local workspace paths
MN_WORKSPACE_ROOT=
MN_MEMBRANE_PROJECT_PATH=
MN_MEMBRANE_SDK_PATH=
MN_SKILLS_ROOT=

# Blueprint runtime hooks
MN_PRE_LAUNCH_TIMEOUT_SECONDS=30
MN_POST_LAUNCH_TIMEOUT_SECONDS=10
MN_PROCESS_CLEANUP_TIMEOUT_SECONDS=5
MN_RUN_BACKGROUND_EVENT_RELAY=1
MN_RUN_EVENT_RELAY_POLL_SECONDS=
MN_RUN_EVENT_RELAY_MAX_SECONDS=
